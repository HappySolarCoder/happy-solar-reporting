{
  "functions": {
    "api/index.py": {
      "includeFiles": "api/**",
      "maxDuration": 90
    },
    "api/metrics/inbound_cac.py": {
      "maxDuration": 90
    },
    "api/powerline_dashboard.py": {
      "maxDuration": 90
    },
    "api/metrics/raydar_doors_knocked.py": {
      "maxDuration": 90
    },
    "api/metrics/kixie_calls_summary.py": {
      "maxDuration": 90
    },
    "api/website_traffic.py": {
      "maxDuration": 90
    }
  },
  "rewrites": [
    {
      "source": "/growth",
      "destination": "/api?hs=growth_command_center"
    },
    {
      "source": "/growth/",
      "destination": "/api?hs=growth_command_center"
    },
    {
      "source": "/private/fma-payroll",
      "destination": "/api?hs=private/fma_payroll_page"
    },
    {
      "source": "/private/fma-payroll/",
      "destination": "/api?hs=private/fma_payroll_page"
    },
    {
      "source": "/enerflo-installer",
      "destination": "/api?hs=enerflo_installer_page"
    },
    {
      "source": "/enerflo-installer/",
      "destination": "/api?hs=enerflo_installer_page"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?hs=:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/warm_cache",
      "schedule": "0 * * * *"
    }
  ]
}
